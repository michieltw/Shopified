{{ 'configurator.css' | asset_url | stylesheet_tag }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="{{ 'configurator.js' | asset_url }}" defer="defer"></script>

{% assign base_product = section.settings.base_product %}
{% assign base_variant = base_product.selected_or_first_available_variant %}

<script type="application/json" id="configurator-options-data">
  [
    {% for block in section.blocks %}
      {
        "id": {{ block.settings.id | json }},
        "name": {{ block.settings.title | json }},
        "type": {{ block.settings.type | json }},
        "options": [{% assign opts = block.settings.options_list | split: ',' %}{% for opt in opts %}{{ opt | strip | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
        "default": {{ block.settings.default_value | json }},
        "surcharges": {% if block.settings.surcharges_json != blank %}{{ block.settings.surcharges_json }}{% else %}{}{% endif %},
        "min": {{ block.settings.min_value | default: 1 | json }},
        "info": {{ block.settings.info_text | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
</script>

<div class="blackout-configurator" data-section-id="{{ section.id }}" data-variant-id="{{ base_variant.id }}" data-delivery-base="{{ section.settings.delivery_text | escape }}" data-delivery-premium="{{ section.settings.delivery_text_premium | default: '6-8 Weeks' | escape }}">
  <div class="configurator-layout">

    <!-- Left Side: Visualizer -->
    <div class="configurator-visualizer">
      <div class="visualizer-header">
        <img src="{{ 'blackout_logo.png' | asset_url }}" alt="Blackout Hockey" class="logo" loading="lazy">
        <button class="btn-text" id="btn-ask-advice">{{ section.settings.advice_text }}</button>
      </div>

      <div class="stick-preview-container" id="stick-preview-container">
        <!-- Base layer (always present) -->
        <img src="{{ section.settings.base_stick_image | image_url: width: 800 }}" class="stick-layer layer-base" alt="Stick Base" loading="lazy">
        <!-- Dynamic layers injected by JS based on selection -->
        <div id="dynamic-layers"></div>
      </div>
    </div>

    <!-- Right Side: Controls -->
    <div class="configurator-controls">
      <div class="controls-header">
        <h1 class="title">{{ section.settings.title }}</h1>
        <p class="subtitle">{{ section.settings.subtitle }}</p>
      </div>

      <div class="options-container" id="options-container">
        <!-- Options injected here by JS -->
      </div>

      <!-- Performance Indicators (Read-only) -->
      <div class="performance-indicators mt-8">
        <h3 class="section-title">Performance Indicators</h3>
        <div class="radar-stats">
          <div class="stat-row"><span>Power</span> <div class="bar"><div class="fill" id="stat-power" style="width: 85%"></div></div></div>
          <div class="stat-row"><span>Speed</span> <div class="bar"><div class="fill" id="stat-speed" style="width: 92%"></div></div></div>
          <div class="stat-row"><span>Accuracy</span> <div class="bar"><div class="fill" id="stat-accuracy" style="width: 90%"></div></div></div>
          <div class="stat-row"><span>Agility</span> <div class="bar"><div class="fill" id="stat-agility" style="width: 88%"></div></div></div>
          <div class="stat-row"><span>Durability</span> <div class="bar"><div class="fill" id="stat-durability" style="width: 95%"></div></div></div>
          <div class="stat-row"><span>Sensitivity</span> <div class="bar"><div class="fill" id="stat-sensitivity" style="width: 80%"></div></div></div>
        </div>
        <div class="text-stats mt-4">
          <p><strong>Material:</strong> {{ section.settings.material_text }}</p>
          <p><strong>Estimated Delivery:</strong> <span id="delivery-estimate">{{ section.settings.delivery_text }}</span></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Footer for Mobile & Desktop -->
  <div class="configurator-footer">
    <button class="btn-secondary" id="btn-overview">Overview</button>
    <button class="btn-secondary" id="btn-share">Share Link</button>
    <div class="price-display">
      <span class="currency">{{ cart.currency.symbol }}</span><span id="total-price">{{ section.settings.base_price }}</span>
    </div>
    <div class="action-buttons">
      <button class="btn-primary" id="btn-pdf">Get PDF</button>
      <button class="btn-primary" id="btn-checkout">Checkout</button>
    </div>
  </div>

  <!-- Overview Modal -->
  <div id="overview-modal" class="modal-overlay hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Build Summary</h2>
        <button id="btn-close-modal" class="btn-close">&times;</button>
      </div>
      <div class="modal-body">
        <p class="text-sm text-gray-400 mb-2 uppercase">Unique Build Code</p>
        <div class="build-code-box">
          <code id="build-code-display"></code>
        </div>
        <ul id="summary-list" class="summary-list"></ul>
      </div>
    </div>
  </div>

  <!-- Info Modal -->
  <div id="info-modal" class="modal-overlay hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="info-modal-title">Information</h2>
        <button id="btn-close-info-modal" class="btn-close">&times;</button>
      </div>
      <div class="modal-body" id="info-modal-body">
        <!-- Content injected via JS -->
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Stick Configurator",
  "settings": [
    {
      "type": "product",
      "id": "base_product",
      "label": "Base Product for Checkout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Build Your Stick"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Select your options below. Changes update in real-time."
    },
    {
      "type": "number",
      "id": "base_price",
      "label": "Base Price",
      "default": 200
    },
    {
      "type": "text",
      "id": "advice_text",
      "label": "Advice Button Text",
      "default": "Ask for Advice"
    },
    {
      "type": "text",
      "id": "material_text",
      "label": "Material Description",
      "default": "100% 18K Toray Carbon Fiber"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Base Delivery Estimate",
      "default": "4-6 Weeks"
    },
    {
      "type": "text",
      "id": "delivery_text_premium",
      "label": "Premium Delivery Estimate",
      "default": "6-8 Weeks"
    },
    {
      "type": "image_picker",
      "id": "base_stick_image",
      "label": "Base Stick Image (Placeholder)"
    }
  ],
  "blocks": [
    {
      "type": "configurator_option",
      "name": "Configurator Option",
      "settings": [
        {
          "type": "text",
          "id": "id",
          "label": "Option ID (e.g. flexProfile)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Display Name"
        },
        {
          "type": "richtext",
          "id": "info_text",
          "label": "Information Popup Text",
          "info": "Leave blank to disable the info button for this option."
        },
        {
          "type": "select",
          "id": "type",
          "label": "Input Type",
          "options": [
            { "value": "select", "label": "Select Buttons" },
            { "value": "text", "label": "Text Input" },
            { "value": "number", "label": "Number Input" }
          ],
          "default": "select"
        },
        {
          "type": "textarea",
          "id": "options_list",
          "label": "Options List (Comma separated for 'select')",
          "info": "E.g.: Low kick, Mid kick, High kick"
        },
        {
          "type": "text",
          "id": "default_value",
          "label": "Default Value"
        },
        {
          "type": "textarea",
          "id": "surcharges_json",
          "label": "Surcharges (JSON Object)",
          "info": "E.g.: {\"Full Custom (+€30)\": 30}"
        },
        {
          "type": "number",
          "id": "min_value",
          "label": "Minimum Value (for 'number' type)",
          "default": 1
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stick Configurator"
    }
  ]
}
{% endschema %}
