{{ 'configurator.css' | asset_url | stylesheet_tag }}

<div class="guided-selling-container blackout-theme">
  <div class="quiz-box">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    <div id="quiz-content" class="mt-8">
      <!-- Quiz logic handled by JS -->
      <div class="question">
        <h3>What is your play style?</h3>
        <div class="options">
          <button class="btn-quiz" data-value="sniper">Sniper (Quick Release)</button>
          <button class="btn-quiz" data-value="playmaker">Playmaker (Puck Control)</button>
          <button class="btn-quiz" data-value="power">Power (Heavy Shots)</button>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a href="/pages/configurator?build=eyJmaWxsZXIiOiJ0cnVlIn0=" id="btn-finish-quiz" class="btn-primary">Generate My Stick</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guided Selling Quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Stick"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Answer a few questions and we will recommend the perfect setup for your game."
    }
  ],
  "presets": [
    {
      "name": "Guided Selling Quiz"
    }
  ]
}
{% endschema %}
